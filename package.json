{
  "name": "bridge-club-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "桥牌复式赛计分与双明手复盘工具",
  "scripts": {
    "test": "node --loader ./scripts/ts-loader.mjs --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "start": "node scripts/server.mjs",
    "perf": "node --loader ./scripts/ts-loader.mjs tests/perf.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
